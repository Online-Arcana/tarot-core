{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kittycrow.dev/schemas/online-arcana-medium-map-v3.json",
  "title": "Online Arcana reader medium map",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "status",
    "reader",
    "culture",
    "presentation",
    "sourceRegistry",
    "culturalElementRegistry",
    "cards"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 3 },
    "status": {
      "type": "object",
      "required": ["state", "culturalSpecialistReviewRequired"],
      "properties": {
        "state": { "type": "string", "minLength": 1 },
        "culturalSpecialistReviewRequired": { "const": true },
        "note": { "$ref": "#/$defs/localString" }
      }
    },
    "reader": {
      "enum": ["brennos", "yejide", "ngaru", "ame", "amaru", "nahid", "mictli"]
    },
    "culture": { "$ref": "#/$defs/localString" },
    "presentation": { "$ref": "#/$defs/presentation" },
    "sourceRegistry": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/source" }
    },
    "culturalElementRegistry": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/element" }
    },
    "cards": {
      "type": "object",
      "minProperties": 78,
      "maxProperties": 78,
      "propertyNames": {
        "pattern": "^(major-[a-z0-9-]+|(wands|cups|swords|pentacles)-(ace|two|three|four|five|six|seven|eight|nine|ten|page|knight|queen|king))$"
      },
      "additionalProperties": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "localString": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "es"],
      "properties": {
        "en": { "type": "string", "minLength": 1 },
        "es": { "type": "string", "minLength": 1 }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "url", "note"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "note": { "type": "string", "minLength": 1 }
      }
    },
    "element": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "sourceIds", "sensitivity"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "$ref": "#/$defs/localString" },
        "sourceIds": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "sensitivity": { "type": "string", "minLength": 1 }
      }
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rankMode", "majorMode", "states", "families"],
      "properties": {
        "rankMode": { "enum": ["entity", "count"] },
        "majorMode": {
          "enum": ["carved-being", "painted-being", "mixed-petals", "compound-cord", "complex-smoke", "deity-disk"]
        },
        "states": {
          "type": "object",
          "additionalProperties": false,
          "required": ["upright", "reversed"],
          "properties": {
            "upright": { "$ref": "#/$defs/localString" },
            "reversed": { "$ref": "#/$defs/localString" }
          }
        },
        "families": {
          "type": "object",
          "additionalProperties": false,
          "required": ["wands", "cups", "swords", "pentacles"],
          "properties": {
            "wands": { "$ref": "#/$defs/localString" },
            "cups": { "$ref": "#/$defs/localString" },
            "swords": { "$ref": "#/$defs/localString" },
            "pentacles": { "$ref": "#/$defs/localString" }
          }
        }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["itemName", "culturalElementIds"],
      "properties": {
        "itemName": { "$ref": "#/$defs/localString" },
        "culturalElementIds": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "itemDescription": { "$ref": "#/$defs/localString" }
      }
    }
  }
}
