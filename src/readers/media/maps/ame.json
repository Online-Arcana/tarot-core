{"$schema":"../medium-map.schema.json","version":2,"status":{"state":"source-backed-draft","runtimeIntegrated":true,"culturalSpecialistReviewRequired":true,"note":{"en":"The physical elements and named beings are backed by the cited historical, museum, folklore or religious sources. The one-to-one card correspondences, rank order and divination method are Online Arcana fiction.","es":"Los elementos físicos y los seres nombrados están respaldados por las fuentes históricas, museísticas, folclóricas o religiosas citadas. Las correspondencias individuales con los naipes, el orden de rangos y el método de adivinación son ficción de Online Arcana."}},"reader":"ame","readerName":{"en":"Ame","es":"Ame"},"culture":{"en":"Japanese seasonal flowers, Shinto mythology and documented yōkai folklore","es":"Flores estacionales japonesas, mitología sintoísta y folclore yōkai documentado"},"medium":{"en":"sakura, hasu, fuji and ajisai petals cast together onto collected rainwater","es":"pétalos de sakura, hasu, fuji y ajisai lanzados juntos sobre agua de lluvia recogida"},"canonicalDeck":{"name":{"en":"Online Arcana naipes","es":"Naipes de Online Arcana"},"cardCount":78,"orientationValues":["upright","reversed"],"mappingRule":{"en":"Exactly one fixed medium result per canonical card; the public state is selected by the canonical orientation.","es":"Exactamente un resultado fijo del medio por cada naipe canónico; el estado público se selecciona mediante la orientación canónica."}},"presentation":{"rankMode":"count","majorMode":"mixed-petals","states":{"upright":{"en":"still","es":"quieto"},"reversed":{"en":"drifting","es":"a la deriva"}},"families":{"wands":{"en":"Fuji","es":"Fuji"},"cups":{"en":"Hasu","es":"Hasu"},"swords":{"en":"Sakura","es":"Sakura"},"pentacles":{"en":"Ajisai","es":"Ajisai"}}},"ritual":{"concealment":{"en":"Ame holds one gathered handful containing all four kinds of petals above a basin whose marked areas correspond to the spread positions.","es":"Ame sostiene sobre una pila un solo puñado que contiene los cuatro tipos de pétalos; las zonas marcadas de la pila corresponden a las posiciones de la tirada."},"chance":{"en":"At the beginning of the spread, Ame releases the entire handful once. Every petal falls, collides and drifts into the marked spread areas; no second cast is made.","es":"Al comienzo de la tirada, Ame suelta todo el puñado una sola vez. Todos los pétalos caen, chocan y derivan hacia las zonas marcadas de la tirada; no se realiza un segundo lanzamiento."},"continuation":{"en":"Without casting again, Ame turns her attention to the next marked spread area and counts the petals already resting or drifting there.","es":"Sin volver a lanzar, Ame dirige su atención a la siguiente zona marcada de la tirada y cuenta los pétalos que ya reposan o derivan allí."},"upright":{"en":"The relevant petals are still when that spread position is read.","es":"Los pétalos relevantes están quietos cuando se lee esa posición de la tirada."},"reversed":{"en":"The relevant petals are still drifting when that spread position is read.","es":"Los pétalos relevantes todavía están a la deriva cuando se lee esa posición de la tirada."},"beats":{"en":["basin of collected rainwater","one mixed handful","single release for the whole spread","petals entering marked areas","counting each area without another cast"],"es":["pila de agua de lluvia recogida","un solo puñado mezclado","un único lanzamiento para toda la tirada","pétalos que entran en zonas marcadas","recuento de cada zona sin otro lanzamiento"]}},"sourceRegistry":[{"id":"kew-plants","title":"Royal Botanic Gardens, Kew: Plants of the World Online","url":"https://powo.science.kew.org/","note":"Botanical reference for sakura, lotus, Japanese wisteria and hydrangea."},{"id":"shinto-regalia","title":"Encyclopedia of Shinto: Three sacred treasures","url":"https://d-museum.kokugakuin.ac.jp/eos/detail/?id=8656","note":"Documents Shinto mythic and ritual traditions."},{"id":"shinto-shrines","t