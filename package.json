{
  "name": "tarot-engine-core",
  "version": "3.5.2",
  "private": true,
  "type": "module",
  "bin": {
    "tarot-core": "./dist/cli/main.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./cli/*": "./dist/cli/*.js",
    "./contracts/*": "./dist/contracts/*.js",
    "./domain/*": "./dist/domain/*.js",
    "./model/*": "./dist/model/*.js",
    "./packs/*": "./dist/packs/*.js",
    "./readers/*": "./dist/readers/*.js",
    "./reading/*": "./dist/reading/*.js",
    "./transport/*": "./dist/transport/*.js"
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "check": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "tsc -p tsconfig.build.json && node --experimental-strip-types --test test/*.test.mts",
    "test:media": "tsc -p tsconfig.build.json && node --experimental-strip-types --test test/media-fallback.test.mts test/media-ritual-participation.test.mts",
    "cli": "tsc -p tsconfig.build.json && node dist/cli/main.js",
    "ci": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.build.json && node --experimental-strip-types --test test/*.test.mts"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3"
  }
}
