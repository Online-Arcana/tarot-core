{
  "name": "tarot-engine-core",
  "version": "3.6.1",
  "private": true,
  "type": "module",
  "bin": {
    "tarot-core": "./dist/cli/main.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./cli/*": "./dist/cli/*.js",
    "./contracts/*": "./dist/contracts/*.js",
    "./domain/*": "./dist/domain/*.js",
    "./model/*": "./dist/model/*.js",
    "./packs/*": "./dist/packs/*.js",
    "./readers/*": "./dist/readers/*.js",
    "./reading/*": "./dist/reading/*.js",
    "./transport/*": "./dist/transport/*.js"
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "generate:personas": "node scripts/generate-personas.mjs",
    "generate:fallbacks": "node scripts/generate-fallbacks.mjs",
    "generate:data": "npm run generate:personas && npm run generate:fallbacks",
    "precheck": "npm run generate:data",
    "check": "tsc -p tsconfig.json --noEmit",
    "check:live-harness": "node --check scripts/run-live-prose-matrix.mjs && node --check scripts/live-prose-matrix.mjs && node --check scripts/aggregate-live-prose.mjs && node --check scripts/render-live-prose-review.mjs",
    "prebuild": "npm run generate:data",
    "build": "tsc -p tsconfig.build.json",
    "test": "node --experimental-strip-types --test test/*.test.mts",
    "cli": "npm run build && node dist/cli/main.js",
    "ci": "npm run check && npm run check:live-harness && npm run build && npm run test",
    "test:live": "npm run build && node scripts/run-live-prose-matrix.mjs",
    "test:live:cell": "npm run build && node scripts/live-prose-matrix.mjs",
    "test:live:aggregate": "node scripts/aggregate-live-prose.mjs",
    "test:live:review": "node scripts/render-live-prose-review.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3"
  }
}
